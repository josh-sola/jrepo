{
  "name": "gt-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GT_API_DATA_DIR=~/.local/share/gt-api-dev bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
