{
  "name": "gt-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GT_API_DATA_DIR=~/.local/share/gt-api-dev bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test && bun run openapi:check",
    "openapi": "bun scripts/openapi.ts",
    "openapi:check": "bun scripts/openapi.ts --check"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@octokit/graphql": "^9.0.5",
    "@octokit/rest": "^22.0.1",
    "@scalar/hono-api-reference": "^0.12.12",
    "hono": "^4.13.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  }
}
