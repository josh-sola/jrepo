{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "singleAttributePerLine": false,
  "sortPackageJson": false,
  "sortImports": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml",
    "**/*.toml",
    "**/generated/**",
    "**/__generated__/**",
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "dist/**"
  ]
}
