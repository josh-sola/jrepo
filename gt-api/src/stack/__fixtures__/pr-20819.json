  "number": 20819,
  "state": "open",
  "locked": false,
  "title": "[BE-3519] workflow-converter: map Select records to select or legacySelect",
  "user": {
    "login": "coryjk-sola",
    "id": 266803737,
    "node_id": "U_kgDOD-caGQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/266803737?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/coryjk-sola",
    "html_url": "https://github.com/coryjk-sola",
    "followers_url": "https://api.github.com/users/coryjk-sola/followers",
    "following_url": "https://api.github.com/users/coryjk-sola/following{/other_user}",
    "gists_url": "https://api.github.com/users/coryjk-sola/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/coryjk-sola/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/coryjk-sola/subscriptions",
    "organizations_url": "https://api.github.com/users/coryjk-sola/orgs",
    "repos_url": "https://api.github.com/users/coryjk-sola/repos",
    "events_url": "https://api.github.com/users/coryjk-sola/events{/privacy}",
    "received_events_url": "https://api.github.com/users/coryjk-sola/received_events",
    "type": "User",
