  "title": "[BE-3519] actions: expose select and legacySelect contracts",
  "user": {
    "login": "coryjk-sola",
    "id": 266803737,
    "node_id": "U_kgDOD-caGQ",
    "avatar_url": "https://avatars.githubusercontent.com/u/266803737?v=4",
    "gravatar_id": "",
