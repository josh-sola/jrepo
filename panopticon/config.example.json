{
  "githubLogin": "josh-sola",
  "gtApiUrl": "http://gt-api.k8s.orb.local",
  "repos": {
    "Sola-Solutions/monorepo": {
      "trunk": "master",
      "hover": {
        "steps": [
          { "profile": "node", "run": "pnpm install --frozen-lockfile" },
          { "profile": "node", "run": "pnpm build:packages" },
          {
            "profile": "python",
            "cwd": "python",
            "run": "uv sync --all-packages"
          }
        ]
      }
    }
  }
}
